{
  "appId": "com.shangantong.app",
  "appName": "上岸通",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://civil-service-workbench.app.workbuddy.host/?sharecode=GCYR427BEX",
    "allowNavigation": [
      "civil-service-workbench.app.workbuddy.host"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 900,
      "backgroundColor": "#f7f5f0",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#f7f5f0"
    }
  }
}
