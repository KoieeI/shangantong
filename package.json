{
  "name": "shangantong-app",
  "version": "1.0.23",
  "private": true,
  "description": "上岸通 · Android / iOS 壳工程（Capacitor）",
  "scripts": {
    "android:add": "cap add android",
    "ios:add": "cap add ios",
    "sync": "cap sync",
    "patch:android": "node native/patch-android.mjs",
    "patch:ios": "node native/patch-ios.mjs",
    "patch:all": "node native/patch-android.mjs && node native/patch-ios.mjs",
    "version:show": "node native/bump-version.mjs --names",
    "version:bump": "node native/bump-version.mjs --bump"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@ebarooni/capacitor-calendar": "^6.6.0",
    "@mozartec/capacitor-microphone": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
